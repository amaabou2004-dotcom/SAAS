# Public browser configuration — never put secret keys in VITE_ variables.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-or-anon-key
VITE_APP_URL=http://localhost:5173

# API configuration (apps/api/.env)
PORT=3001
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-or-anon-key

# Reserved for server-only workers in later iterations.
# Never expose this value through VITE_ variables or commit it.
# SUPABASE_SECRET_KEY=
# RESEND_API_KEY=
